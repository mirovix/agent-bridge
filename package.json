{
  "name": "agent-bridge",
  "version": "1.6.0",
  "description": "Secure remote web console for Claude Code, Codex and other AI coding agents running on your PC",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node src/server.js",
    "service:install": "node scripts/install-service.js install",
